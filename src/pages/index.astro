---
import Base from '../layouts/Base.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { installCommand, siteDescription, siteName } from '../site.js';
import '../styles/landing.css';
---

<Base>
  <a class="skip" href="#content">Skip to content</a>
  <header class="top">
    <a class="word" href="/"><i></i>{siteName}</a>
    <nav aria-label="Primary">
      <a href="/docs/">Docs</a>
      <a href="https://github.com/edheltzel/Do-Skills">GitHub</a>
      <ThemeToggle />
    </nav>
  </header>
  <main id="content" class="sheet">
    <h1>{siteName}</h1>
    <p class="sub">{siteDescription}</p>
    <div class="cmd">
      <div class="cmd-scroll">
        <span class="d" aria-hidden="true">$</span><span class="t">{installCommand}</span>
      </div>
      <button class="cp" type="button">Copy</button>
    </div>
    <p class="hint">This page is a placeholder.</p>
  </main>
</Base>

<script>
  import { installCommand } from '../site.js';

  const copy = document.querySelector<HTMLButtonElement>('.cmd .cp');
  const shown = document.querySelector('.cmd .t')?.textContent ?? '';
  if (shown !== installCommand) throw new Error('install command mismatch');
  copy?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(installCommand);
      copy.textContent = 'Copied';
      window.setTimeout(() => {
        copy.textContent = 'Copy';
      }, 1200);
    } catch {
      copy.textContent = 'Failed';
      window.setTimeout(() => {
        copy.textContent = 'Copy';
      }, 1600);
    }
  });
</script>
